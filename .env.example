# Zerodha Kite Connect API Settings
ZERODHA_API_KEY=your_zerodha_api_key_here
ZERODHA_ACCESS_TOKEN_FILE=token.txt

# Telegram Alert Settings
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Trading / Risk Parameters
INITIAL_CAPITAL=100000
RISK_PER_TRADE=0.01
MINIMUM_RISK_REWARD=2.0
MINIMUM_CANDIDATE_SCORE=80

# Operational Safety
# Keep true - NO broker orders will be placed automatically
SIGNAL_ONLY=true

# Market Data Pipeline Settings
HISTORY_DAYS=220
MAX_UNIVERSE_SYMBOLS=300
MAX_HISTORICAL_DOWNLOAD_SYMBOLS=300
ZERODHA_REQUEST_DELAY_SECONDS=0.35
MARKET_DATA_CACHE_DIR=database/market_data_cache
CONTROLLED_UNIVERSE_SIZE=300

# Price Filters (optional - filters out stocks below/above specified price)
MINIMUM_STOCK_PRICE=20
# MAXIMUM_STOCK_PRICE=5000
