def is_spam_or_fake_signal(text: str) -> bool:
    """Detect and filter clickbait, promotional spam, and pump-and-dump hype."""
    if not text:
        return False
    text_lower = text.lower()
    for pattern in SPAM_AND_FAKE_PATTERNS:
        if re.search(pattern, text_lower):
            return True
    return False

