# CALCULATE NEWS SCORE WITH REAL AGE DECAY
# ──────────────────────────────────────────────────────────────
def calculate_news_score(sentiment: str, age_hours: float) -> float:
    """Direction only. Recency is applied as an aggregation weight, not a bonus."""
    return {'bullish': 75.0, 'bearish': 25.0}.get(sentiment, 50.0)


