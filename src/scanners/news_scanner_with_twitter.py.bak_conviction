# ──────────────────────────────────────────────────────────────
# ROBUST DATE/TIME PARSING (Requires Explicit Timezone)
# ──────────────────────────────────────────────────────────────
def parse_datetime_robust(date_str: str | None) -> datetime | None:
    """Accept only timestamps carrying an explicit offset; never invent a zone."""
    if not isinstance(date_str, str) or not date_str.strip():
        return None
    value = date_str.strip()
    for parser in (parsedate_to_datetime, lambda v: datetime.fromisoformat(v.replace('Z', '+00:00'))):
        try:
            dt = parser(value)
            if dt.tzinfo is not None and dt.utcoffset() is not None:
                return dt.astimezone(timezone.utc)
        except (ValueError, TypeError, OverflowError):
            pass
    return None


def _find_first_child(item: ET.Element, tags: list[str]) -> ET.Element | None:
    """Helper to find first matching XML child tag without evaluating truthiness of Element"""
    for t in tags:
        elem = item.find(t)
        if elem is not None:
            return elem
    return None


# ──────────────────────────────────────────────────────────────
# FETCH RSS FEEDS WITH RETRY LOGIC & ACCURATE DATES
# ──────────────────────────────────────────────────────────────
def fetch_rss_feed(url: str, max_retries: int = 2) -> list[dict]:
    """Read publication dates and actual publishers, with visible feed failures."""
    error = ''
    for attempt in range(max_retries):
        try:
            resp = requests.get(url, headers={'User-Agent': 'NewsResearchScanner/2.0'}, timeout=12)
            resp.raise_for_status()
            root = ET.fromstring(resp.content)
            entries = root.findall('.//item')
            if not entries:
                entries = root.findall('.//{http://www.w3.org/2005/Atom}entry') or root.findall('.//entry')
            items = []
            no_date_count = 0
            for entry in entries:
                title = _find_first_child(entry, ['title', '{http://www.w3.org/2005/Atom}title'])
                if title is None or not title.text:
                    continue
                link = _find_first_child(entry, ['link', '{http://www.w3.org/2005/Atom}link'])
                desc = _find_first_child(entry, ['description', 'summary', '{http://www.w3.org/2005/Atom}summary'])
                pub = _find_first_child(entry, ['pubDate', 'pubdate', '{http://purl.org/dc/elements/1.1/}date', 'date', 'published', '{http://www.w3.org/2005/Atom}published'])
                updated = _find_first_child(entry, ['updated', '{http://www.w3.org/2005/Atom}updated'])
                source = entry.find('source')
                pub_dt = parse_datetime_robust(pub.text if pub is not None else None)
                if pub_dt is None:
                    no_date_count += 1
                items.append({
                    'title': clean_text(title.text),
                    'link': (link.get('href', '') or link.text or '').strip() if link is not None else '',
                    'description': clean_text(desc.text or '') if desc is not None else '',
                    'published': pub_dt,
                    'updated': parse_datetime_robust(updated.text if updated is not None else None),
                    'timestamp_kind': 'published',
                    'publisher_url': source.get('url', '') if source is not None else '',
                    'publisher_name': clean_text(source.text or '') if source is not None else '',
                })
            dated_count = len(items) - no_date_count
            if len(entries) == 0:
                status = 'EMPTY_FEED'
                is_ok = True
            elif dated_count == 0 and no_date_count > 0:
                status = 'NO_USABLE_DATES'
                is_ok = False
            elif dated_count > 0:
                status = 'OK'
                is_ok = True
            else:
                status = 'HEALTHY_EMPTY'
                is_ok = True

            FETCH_STATUS[url] = {
                'ok': is_ok,
                'fetched': len(entries),
                'dated': dated_count,
                'rejected_no_date': no_date_count,
                'status': status
            }
            return items
        except (requests.RequestException, ET.ParseError, ValueError) as exc:
            error = str(exc)
            if attempt + 1 < max_retries:
                time.sleep(0.25)
    FETCH_STATUS[url] = {'ok': False, 'error': error}
    logger.warning('Feed failed: %s: %s', url, error)
    return []


