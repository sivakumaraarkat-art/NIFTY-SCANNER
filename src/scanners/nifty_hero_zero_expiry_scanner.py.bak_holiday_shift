        return "N/A"
    return f"<code>{html_escape(str(val))}</code>"


def tg_money(val: Any) -> str:
    if val is None or val == "":
        return "N/A"
    try:
        return f"₹{float(val):,.2f}"
    except (TypeError, ValueError):
        return str(val)


def tg_points(val: Any, signed: bool = False) -> str:
