# ==============================================================================
# UNIFIED TRADING ENGINE & AUTOMATED AUDIT SCHEDULE (ORACLE VM)
# Timezone: Asia/Kolkata (IST)
# ==============================================================================
CRON_TZ=Asia/Kolkata

# 1. 06:00 AM (Mon-Fri): Daily Pre-Market System Cleanup & Memory Refresh
00 06 * * 1-5 /home/ubuntu/NiftyScanner/daily_system_maintenance.sh >> /home/ubuntu/NiftyScanner/cron_logs/cron_maintenance.log 2>&1

# 2. 07:00 AM (Mon-Fri): Automated Zerodha Kite Connect Token Generation
00 07 * * 1-5 /home/ubuntu/NiftyScanner/nifty_v14_7/.venv/bin/python /home/ubuntu/NiftyScanner/nifty_v14_7/scripts/auto_kite_auth.py >> /home/ubuntu/NiftyScanner/nifty_v14_7/logs/auto_auth_cron.log 2>&1

# 3. 08:30 AM (Mon-Fri): Pre-Market News Catalyst Scanner (For Intraday)
30 08 * * 1-5 cd /home/ubuntu/NiftyScanner/STOCK_SWING_V1_updated && PYTHONPATH=/home/ubuntu/NiftyScanner/nifty_v14_7/venv/lib/python3.12/site-packages /usr/bin/python3 src/scanners/news_scanner_with_twitter.py --hours 48 >> /home/ubuntu/NiftyScanner/cron_logs/cron_news_am.log 2>&1

# 4. 09:00 AM (Mon-Fri): NIFTY V14.9 Paper Trading Engine
00 09 * * 1-5 /home/ubuntu/NiftyScanner/nifty_v14_7/run_NIFTY_V14_9_CRON.sh >> /home/ubuntu/NiftyScanner/nifty_v14_7/logs/cron_v14_9.log 2>&1

# 5. 09:12 AM (Mon-Fri): BTST Smart Exit Monitor
12 09 * * 1-5 cd /home/ubuntu/NiftyScanner/STOCK_SWING_V1_updated && PYTHONPATH=/home/ubuntu/NiftyScanner/nifty_v14_7/venv/lib/python3.12/site-packages /usr/bin/python3 src/scanners/btst_smart_exit_strategy.py --cron >> /home/ubuntu/NiftyScanner/cron_logs/cron_btst_exit.log 2>&1

# 6. 09:15 AM (Mon-Fri): Portfolio Peak Guard Continuous Sentinel
15 09 * * 1-5 /home/ubuntu/NiftyScanner/PORTFOLIO_PEAK_EXIT_GUARD/run_continuous_monitor.sh >> /home/ubuntu/NiftyScanner/PORTFOLIO_PEAK_EXIT_GUARD/logs/cron_sentinel.log 2>&1

# 7. Intraday News Catalyst Refresh (Runs at 09:35 AM and hourly at :45)
35 09 * * 1-5 cd /home/ubuntu/NiftyScanner/STOCK_SWING_V1_updated && PYTHONPATH=/home/ubuntu/NiftyScanner/nifty_v14_7/venv/lib/python3.12/site-packages /usr/bin/python3 src/scanners/news_scanner_with_twitter.py --hours 12 >> /home/ubuntu/NiftyScanner/cron_logs/cron_news_intraday.log 2>&1
45 10-14 * * 1-5 cd /home/ubuntu/NiftyScanner/STOCK_SWING_V1_updated && PYTHONPATH=/home/ubuntu/NiftyScanner/nifty_v14_7/venv/lib/python3.12/site-packages /usr/bin/python3 src/scanners/news_scanner_with_twitter.py --hours 12 >> /home/ubuntu/NiftyScanner/cron_logs/cron_news_intraday.log 2>&1

# 8. Options Intraday Scan (09:50 AM, then every 1 hour at :50 until 02:50 PM, Min Score 60)
# FIX: flock -w 300 waits up to 5 min for lock instead of -n which silently drops runs
50 09 * * 1-5 flock -w 300 /tmp/intraday_scan.lock bash -lc 'cd /home/ubuntu/NiftyScanner/STOCK_SWING_V1_updated && PYTHONPATH=/home/ubuntu/NiftyScanner/nifty_v14_7/venv/lib/python3.12/site-packages /usr/bin/python3 src/scanners/run_options_intraday_scan_powerful_sl.py --use-news-candidates --min-score 60 >> /home/ubuntu/NiftyScanner/cron_logs/cron_intraday.log 2>&1'
50 10-14 * * 1-5 flock -w 300 /tmp/intraday_scan.lock bash -lc 'cd /home/ubuntu/NiftyScanner/STOCK_SWING_V1_updated && PYTHONPATH=/home/ubuntu/NiftyScanner/nifty_v14_7/venv/lib/python3.12/site-packages /usr/bin/python3 src/scanners/run_options_intraday_scan_powerful_sl.py --use-news-candidates --min-score 60 >> /home/ubuntu/NiftyScanner/cron_logs/cron_intraday.log 2>&1'

# 8b. MCX Crude Oil Momentum Scan (Runs daily at 10:00 AM)
00 10 * * 1-5 cd /home/ubuntu/NiftyScanner/STOCK_SWING_V1_updated && PYTHONPATH=/home/ubuntu/NiftyScanner/nifty_v14_7/venv/lib/python3.12/site-packages /usr/bin/python3 src/scanners/run_crude_swing_scan.py >> /home/ubuntu/NiftyScanner/cron_logs/cron_crude.log 2>&1

