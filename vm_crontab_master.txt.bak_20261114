45 11 * * 1-5 cd /home/ubuntu/NiftyScanner/STOCK_SWING_V1_updated && PYTHONPATH=/home/ubuntu/NiftyScanner/nifty_v14_7/venv/lib/python3.12/site-packages /usr/bin/python3 src/scanners/daily_11am_btst_summary.py >> /home/ubuntu/NiftyScanner/cron_logs/cron_btst_11am_summary.log 2>&1

